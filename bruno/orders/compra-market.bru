meta {
  name: 201 FILLED: una compra MARKET ejecuta al último close
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: 3c9f21ab-buy-pamp-10
}

body:json {
  { "userId": 1, "instrumentId": 47, "side": "BUY", "type": "MARKET", "size": 10 }
}

assert {
  res.status: in 200, 201
}

docs {
  Coloca en la primera corrida (201) y repite en las siguientes (200), porque la clave
  ya quedó guardada. Por eso la aserción acepta los dos códigos.
}
