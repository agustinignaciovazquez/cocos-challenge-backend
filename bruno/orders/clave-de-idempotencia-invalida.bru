meta {
  name: 400: un Idempotency-Key fuera de 1-64 caracteres de A-Z, a-z, 0-9, _ y -
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Idempotency-Key: not a key
}

body:json {
  { "userId": 1, "instrumentId": 47, "side": "BUY", "type": "MARKET", "size": 10 }
}

assert {
  res.status: eq 400
}
