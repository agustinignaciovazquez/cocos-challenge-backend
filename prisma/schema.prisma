generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int     @id @default(autoincrement())
  email         String? @db.VarChar(255)
  accountNumber String? @map("accountnumber") @db.VarChar(20)
  orders        Order[]

  @@map("users")
}

model Instrument {
  id         Int          @id @default(autoincrement())
  ticker     String?      @db.VarChar(10)
  name       String?      @db.VarChar(255)
  type       String?      @db.VarChar(10)
  orders     Order[]
  marketData MarketData[]

  @@map("instruments")
}

model Order {
  id             Int         @id @default(autoincrement())
  instrumentId   Int?        @map("instrumentid")
  userId         Int?        @map("userid")
  size           Int?
  price          Decimal?    @db.Decimal(10, 2)
  type           String?     @db.VarChar(10)
  side           String?     @db.VarChar(10)
  status         String?     @db.VarChar(20)
  datetime       DateTime?   @db.Timestamp(6)
  // Unique per user where it is present. The constraint is a partial index and lives in
  // db/init.sql: a Prisma unique cannot carry the WHERE that leaves unkeyed rows alone.
  idempotencyKey String?     @map("idempotencykey")
  instrument     Instrument? @relation(fields: [instrumentId], references: [id])
  user           User?       @relation(fields: [userId], references: [id])

  @@map("orders")
}

model MarketData {
  id            Int         @id @default(autoincrement())
  instrumentId  Int?        @map("instrumentid")
  high          Decimal?    @db.Decimal(10, 2)
  low           Decimal?    @db.Decimal(10, 2)
  open          Decimal?    @db.Decimal(10, 2)
  close         Decimal?    @db.Decimal(10, 2)
  previousClose Decimal?    @map("previousclose") @db.Decimal(10, 2)
  date          DateTime?   @db.Date
  instrument    Instrument? @relation(fields: [instrumentId], references: [id])

  @@map("marketdata")
}
