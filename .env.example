DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cocos
# The challenge's hosted database instead (credentials never committed):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Prisma pools num_cpus * 2 + 1 connections by default. `connection_limit` caps it, so one
# caller queueing behind a user's placement lock cannot drain the pool and 503 the rest:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/cocos?connection_limit=10
