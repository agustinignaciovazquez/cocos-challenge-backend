{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "\\.e2e-spec\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "<rootDir>/tools/"],
  "modulePathIgnorePatterns": ["<rootDir>/tools/"],
  "transform": { "^.+\\.ts$": "ts-jest" },
  "testEnvironment": "node",
  "testTimeout": 180000,
  "maxWorkers": 1
}
